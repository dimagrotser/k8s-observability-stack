{
  "name": "demo-api",
  "version": "0.1.0",
  "private": true,
  "description": "Small HTTP API with RED metrics, used to demonstrate a Kubernetes observability stack",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test \"test/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "express": "5.2.1",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "supertest": "7.3.0"
  }
}
